@startuml
' === AGENTICS METADATA ===
' diagram_id: uc_1
' diagram_type: use_case
' name: Gestão de Autenticação
' source_requirements: [req1, req2, req3, req4]
' === END METADATA ===

left to right direction

actor "Usuário"       as ator_usuario  <<primary>>
actor "Administrador" as ator_admin    <<primary>>
actor "Email Service" as ator_email    <<secondary>>

usecase "Realizar Login"      as uc_login     << req:req1 >>
usecase "Validar Credenciais" as uc_validar   << req:req2 >>
usecase "Gerenciar Usuários"  as uc_gerenciar << req:req3 >>
usecase "Confirmar Conta"     as uc_confirmar << req:req4 >>

ator_usuario --> uc_login
uc_login     ..> uc_validar   : <<include>>

ator_admin   --> uc_gerenciar
uc_gerenciar ..> uc_confirmar : <<extend>>
ator_email   --> uc_confirmar
@enduml
