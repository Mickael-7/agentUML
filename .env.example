# LLM Provider: anthropic | openai | gemini
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-7
LLM_TEMPERATURE=0.2

# Retry / refinement limits
LLM_MAX_VALIDATION_RETRIES=3
LLM_MAX_REFINEMENT_ROUNDS=2

# Critic quality threshold (0-10)
CRITIC_SCORE_THRESHOLD=7

# API keys (only the one matching LLM_PROVIDER is required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# PlantUML JAR path or command name (e.g. "plantuml" if on PATH)
PLANTUML_JAR=./tools/plantuml.jar

# Output directory for generated .puml files
OUTPUT_DIR=./output
